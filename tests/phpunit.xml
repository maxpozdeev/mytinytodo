<phpunit defaultTestSuite="default" bootstrap="bootstrap.php" colors="true"
  displayDetailsOnTestsThatTriggerWarnings="true"
  displayDetailsOnTestsThatTriggerNotices="true"
  displayDetailsOnTestsThatTriggerDeprecations="true"
  failOnWarning="true" failOnDeprecation="true" failOnNotice="true"
>
  <testsuites>
    <testsuite name="default">
      <directory suffix="Test.php">.</directory>
      <exclude>./driver_*</exclude>
      <exclude>./vendor/</exclude>
      <exclude>./integration</exclude>
      <exclude>./functional</exclude>
    </testsuite>
    <testsuite name="integration">
      <directory suffix="Test.php">./integration</directory>
    </testsuite>
    <testsuite name="functional">
      <directory suffix="Test.php">./functional</directory>
    </testsuite>
  </testsuites>
</phpunit>
